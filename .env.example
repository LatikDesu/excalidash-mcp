# Public frontend URL; /api is appended by the client.
EXCALIDASH_URL=https://excalidraw.example.com
EXCALIDASH_API_KEY=replace-with-account-api-key

# Local HTTP listener; Docker explicitly binds 0.0.0.0 inside the container.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
MCP_PORT=8080

# Hostnames, no scheme/path/port. Wildcards are forbidden.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Exact origins, including scheme and port. Missing Origin is allowed.
MCP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080

# EXCALIDASH_DRAWING_ID=
# MCP_MAX_BODY_BYTES=10485760
# MCP_MAX_SESSIONS=64
# MCP_SESSION_IDLE_MS=1800000

{
  "name": "excalidashapi-mcp",
  "version": "0.1.0",
  "description": "MCP server for controlling self-hosted ExcaliDash drawings",
  "author": "Evgeny Soraine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LatikDesu/excalidash-mcp.git"
  },
  "homepage": "https://github.com/LatikDesu/excalidash-mcp#readme",
  "bugs": {
    "url": "https://github.com/LatikDesu/excalidash-mcp/issues"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "excalidash",
    "excalidraw"
  ],
  "type": "module",
  "bin": {
    "excalidashapi-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/excalidash.js",
    "dist/excalidash.js.map",
    "dist/excalidash.d.ts",
    "dist/http.js",
    "dist/http.js.map",
    "dist/http.d.ts",
    "dist/operations.js",
    "dist/operations.js.map",
    "dist/operations.d.ts",
    "dist/scene.js",
    "dist/scene.js.map",
    "dist/scene.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "hono": "4.13.9"
  },
  "engines": {
    "node": ">=20.6"
  }
}